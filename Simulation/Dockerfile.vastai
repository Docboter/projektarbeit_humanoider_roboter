# syntax=docker/dockerfile:1
# Sim + GR00T-Policy-Server — kombinierter Container für vast.ai
#
# Im Gegensatz zum KISSKI-Sim-Container (Dockerfile) enthält dieses Image BEIDE Prozesse:
#   * Isaac Lab / Isaac Sim  — Sim-Client (headless EGL, 4 RGB-Kameras)
#   * GR00T N1.6 Policy      — ZMQ-Server (isolierte venv, kein Dependency-Konflikt)
# Beide starten autonom via /scripts/entrypoint_sim.sh und kommunizieren
# über ZMQ auf localhost:${ZMQ_PORT} (default 5555).
#
# GPU-Anforderung:
#   ≥24 GB VRAM, Ampere+ (RT-Cores für Kamera-Rendering), z. B.:
#   RTX 3090 (24 GB), RTX 4090 (24 GB), A6000 (48 GB), A100 (80 GB, kein RT-Rendering!)
#   ACHTUNG: A100/H100 fehlen RT-Cores → Kamera-Rendering scheitert → nicht geeignet.
#   Auf vast.ai: Filter nach "RTX 3090", "RTX 4090" oder "A6000".
#
# BASIS-IMAGE-MIGRATION (2026-08-07): isaac-lab 2.3.2 → 3.0.0-beta2-post1 (Isaac Sim 5.1 → 6.0).
#   Grund: Isaac Sim 5.1 segfaultet auf RTX PRO 6000 Blackwell mit dem Treiber-Branch 610.x
#   (librtx.scenedb.plugin, bekannter NVIDIA-Bug) und der Server-Treiber ist nicht änderbar.
#   Isaac Sim 6.0 ist gegen neuere Treiber validiert. Folgeänderungen: USER root nötig (Basis
#   endet auf USER isaaclab), Isaac-Sim-Python 3.11 → 3.12, flash-attn-Wheel entsprechend neu.
#   ⚠️ Isaac Lab 3.0.0-beta2 ist BETA und dieser Port ist noch nicht auf Hardware verifiziert —
#   Details/Restrisiken: docs/weiterfuehrend/rl-anleitung.md (Troubleshooting).
#
# Build (vom Repo-Root aus, Kontext = Simulation/):
#   docker build --platform linux/amd64 \
#     -f Simulation/Dockerfile.vastai \
#     -t lucam03/projekt-humanoider-roboter-sim-vastai:latest \
#     Simulation/
#
# Run (lokal zum Testen):
#   docker run -it --rm --gpus all --ipc=host --shm-size=16g \
#     -e HF_TOKEN=hf_... \
#     -e CHECKPOINT_PATH=/data/checkpoints/checkpoint-3000 \
#     -v /pfad/zum/checkpoint:/data/checkpoints \
#     lucam03/projekt-humanoider-roboter-sim-vastai:latest
#
# Interaktive Shell (Entrypoint überspringen):
#   docker run -it --rm --gpus all --ipc=host --shm-size=16g \
#     lucam03/projekt-humanoider-roboter-sim-vastai:latest bash

FROM nvcr.io/nvidia/isaac-lab:3.0.0-beta2-post1

SHELL ["/bin/bash", "-c"]

# isaac-lab:3.0.0-beta2-post1 endet mit `USER isaaclab` (uid 1000) — anders als 2.3.2, das als
# root endete. Ohne dieses USER root scheitern alle folgenden RUN-Schritte (apt-get, /app-Klon,
# mkdir /data) an fehlenden Rechten. Bleibt bis zum Ende gesetzt: die Entrypoints schreiben nach
# /data und /scripts, und auf vast.ai/Docker-Servern läuft der Container ohnehin privilegiert.
USER root

# Isaac Sim EULA/Privacy (non-interaktiv)
ENV ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y \
    NVIDIA_DRIVER_CAPABILITIES=all \
    OMNI_KIT_ACCEPT_EULA=yes

# System-Pakete (zusätzlich zum Isaac-Lab-Basis-Image)
# Isaac Lab 3.0.0-beta2 basiert weiterhin auf Ubuntu 24.04 (Noble) — python3.10-* nicht im Haupt-Repo.
# Deadsnakes-PPA liefert Python 3.10, das mit dem uv.lock des Training-Containers kompatibel ist.
# ffmpeg wird von der LeRobot-v3.0->v2.1-Konvertierung gebraucht: sie schneidet die
# zusammenhaengenden MP4s per Subprozess in Einzel-Episoden (convert_v3_to_v2_standalone.py,
# _extract_video_segment). Der Training-Container hat es seit jeher; hier fehlte es bis
# 2026-08-12, weil der Sim-Pfad den Trainingsdatensatz nie brauchte — die Aktion 'span'
# in server_rl_run.sh braucht ihn jetzt.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-venv \
        python3.10-dev \
        python3-pip \
        git \
        git-lfs \
        curl \
        wget \
        openssh-server \
        ffmpeg \
    && git lfs install \
    && mkdir -p /var/run/sshd /root/.ssh \
    && chmod 700 /root/.ssh \
    && ssh-keygen -A

# uv Paketmanager (exakte Version wie Training-Container)
RUN curl -LsSf https://astral.sh/uv/0.8.14/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# GR00T klonen — gepinnter Commit, identisch mit Training-Container
RUN git clone --branch luca/g1-dex3 https://github.com/lucam06/Isaac-GR00T.git /app/Groot-1.6 \
    && git -C /app/Groot-1.6 checkout 9508b498cb60c0048a8a3ce562b518b53f3d0bcf \
    && git -C /app/Groot-1.6 lfs pull

# GR00T Python-Abhängigkeiten in ISOLIERTER venv installieren.
# Isaac Lab nutzt ${ISAACLAB_PATH}/isaaclab.sh -p (eigenes Python-Bundle).
# GR00T nutzt /app/Groot-1.6/.venv/bin/python — keine gemeinsamen Packages, kein Konflikt.
#
# WICHTIG: venv explizit mit Python 3.10 anlegen. Das isaac-lab-Basisimage (Ubuntu 24.04)
# liefert als system-python3 die Version 3.12. Ohne --python würde uv eine 3.12-venv bauen,
# für die keine Header installiert sind (nur python3.10-dev) → Triton/transformers ruft
# `gcc -I/usr/include/python3.12` auf und scheitert mit "Python.h not found".
# Mit 3.10 entspricht die venv exakt dem funktionierenden Training-Container.
WORKDIR /app/Groot-1.6
RUN uv venv --python /usr/bin/python3.10 /app/Groot-1.6/.venv
RUN UV_PREVIEW=1 UV_HTTP_TIMEOUT=300 UV_CONCURRENT_DOWNLOADS=4 \
    uv sync --frozen --no-install-project --extra dev --no-cache
RUN uv pip install --python /app/Groot-1.6/.venv/bin/python -e . --no-deps
RUN uv pip install --python /app/Groot-1.6/.venv/bin/python jsonlines pyzmq msgpack
# ONNX ist das portable Zwischenformat; TensorRT-cu12 baut und laedt die GPU-spezifische
# DiT-Engine. Der -cu12-Suffix ist Pflicht: das unversionierte NVIDIA-Paket zieht inzwischen
# standardmaessig CUDA-13-Libraries, waehrend dieses Image auf CUDA 12.x basiert.
RUN uv pip install --python /app/Groot-1.6/.venv/bin/python \
        onnx==1.20.1 tensorrt-cu12==11.2.1
# usd-core: standalone-pxr für den Hand-Recolor (recolor_hands_black.py). Isaacs gebündeltes
# Python exponiert pxr NICHT für standalone-Skripte (ohne Kit-App-Start) → der Recolor muss
# über dieses venv laufen. Separates Interpreter-Env als Isaac Sim → kein pxr-Konflikt.
RUN uv pip install --python /app/Groot-1.6/.venv/bin/python usd-core

# DeepSpeed entfernen: reine Trainings-Bibliothek (ZeRO), für die Inferenz in der Sim nicht
# nötig. Das isaac-lab-Image hat keine CUDA-Toolchain (kein nvcc, kein /usr/local/cuda).
# transformers macht beim Import opportunistisch `if is_deepspeed_available(): import deepspeed`;
# `import deepspeed` ruft dann installed_cuda_version() → MissingCUDAException("CUDA_HOME does
# not exist"). Ohne das Paket liefert is_deepspeed_available()==False und der Import entfällt.
# GR00T importiert deepspeed nirgends direkt (nur transformers, das auch ohne läuft).
RUN uv pip uninstall --python /app/Groot-1.6/.venv/bin/python deepspeed || true

# Build-Time-Smoke-Tests: brechen den Build lokal/kostenlos ab, statt erst auf einer
# bezahlten vast.ai-Instanz aufzufallen.
#  (1) venv-Python-Header passend zur venv-Version (sonst scheitert Triton zur Laufzeit)
#  (2) deepspeed wirklich entfernt (sonst CUDA_HOME-Crash beim transformers-Import)
RUN PYVER=$(/app/Groot-1.6/.venv/bin/python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")') \
    && echo "venv-Python: $PYVER" \
    && test -f "/usr/include/python${PYVER}/Python.h" \
        && echo "OK: Python-Header /usr/include/python${PYVER}/Python.h vorhanden" \
        || (echo "FEHLER: /usr/include/python${PYVER}/Python.h fehlt — Triton-Kompilierung würde fehlschlagen"; exit 1)
RUN if /app/Groot-1.6/.venv/bin/python -c "import deepspeed" 2>/dev/null; then \
        echo "FEHLER: deepspeed noch installiert — würde CUDA_HOME-Crash auslösen"; exit 1; \
    else echo "OK: deepspeed entfernt (Inferenz braucht es nicht)"; fi

# Versions-Guard: die flash-attn-Wheel-URL weiter unten ist fest auf cp312 verdrahtet. Bricht der
# Base-Image-Tag diese Annahme (z. B. Rückkehr zu 3.11 oder Sprung auf 3.13), soll der Build hier
# scheitern — nicht erst zur Laufzeit auf dem GPU-Server nach dem 10-GB-Checkpoint-Download.
RUN unset VIRTUAL_ENV && \
    PYV=$(/workspace/isaaclab/_isaac_sim/python.sh -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' | tail -n1) && \
    echo "Isaac-Sim-Python: $PYV" && \
    test "$PYV" = "3.12" || (echo "FEHLER: Isaac-Sim-Python ist $PYV, erwartet 3.12 — flash-attn-Wheel-URL (cp312) passt nicht"; exit 1)

# Sim-Client (client.py) läuft unter Isaac Sims gebündeltem Python (3.12), NICHT der GR00T-venv.
# pyzmq dort installieren, sonst scheitert der Sim-Client mit `ModuleNotFoundError: No module
# named 'zmq'`. (msgpack ist im Isaac-Sim-Python bereits vorhanden; numpy ebenfalls.)
# VIRTUAL_ENV unset, damit python.sh nicht versehentlich die GR00T-venv anspricht.
RUN unset VIRTUAL_ENV && /workspace/isaaclab/_isaac_sim/python.sh -m pip install pyzmq msgpack
RUN unset VIRTUAL_ENV && /workspace/isaaclab/_isaac_sim/python.sh -c \
    "import zmq, msgpack, numpy; print('OK: zmq+msgpack+numpy im Isaac-Sim-Python')"

# rl_finetune.py läuft in-process mit isaaclab (Isaac-Sim-Python 3.12) — braucht daher
# gr00t + flash-attn AUCH im Isaac-Sim-Python. Das isaac-lab-3.0.0-beta2-Image bündelt
# Python 3.12 mit torch 2.10.0+cu128 (cxx11abi=TRUE, per pip-list-Inventar 2026-08-07
# verifiziert) — anders als die GR00T-venv (3.10, cxx11abiFALSE)!
#
# flash-attn MUSS als passendes pre-built Wheel per URL kommen. `pip install flash-attn`
# (ohne Version) lädt den sdist und KOMPILIERT aus dem Quellcode → braucht nvcc, das das
# isaac-lab-Image NICHT hat (kein CUDA-Toolkit) → Build-Abbruch. Das Wheel unten trifft
# alle Achsen exakt: cu12 + torch2.10 + cxx11abiTRUE + cp312 (v2.8.1).
#
# transformers/tokenizers/accelerate auf die von gr00t erwarteten Versionen pinnen (uv.lock).
# Latest transformers bricht GR00Ts eigenen Eagle-Modellcode (is_flash_attn_*-Imports).
# Hinweis: das isaaclab-Paket im 6.0-Image pinnt transformers==4.57.6 — unser Downgrade auf
# 4.51.3 erzeugt eine pip-Konflikt-WARNUNG. Unkritisch: Isaac Labs Kern (Envs/Sensoren/Assets)
# importiert transformers nicht; nur dessen LLM-Extensions täten es, die wir nie laden.
# gr00t: editable install ohne deps (torch, numpy etc. liefert Isaac Sim bereits; deepspeed
# absichtlich nicht installiert).
#
# Die GR00T-Laufzeit-Deps, die beim Modell-Laden (Gr00tPolicy(...)) per Top-Level-Import
# greifen, MÜSSEN ebenfalls rein — sonst crasht rl_finetune.py erst NACH dem 6-GB-Checkpoint-
# Download auf der Instanz. Geprüft via Import des kompletten rl_finetune.py-Pfads:
#   diffusers  -> DiT-Action-Head (modules/dit.py)          ← das trainiert RL
#   peft       -> Eagle-VLM-Backbone (modeling_eagle3_vl.py)
#   dm-tree    -> Hauptmodell (gr00t_n1d6.py, `import tree`)
#   albumentations(+cv2) -> Processor (processing_gr00t_n1d6.py)
#   lmdb, av   -> Eagle-Processor (processing_eagle3_vl.py)
#   tyro       -> gr00t.model.__init__ -> configs-Kette
#   pandas     -> Dataset-Kette (gr00t.model.__init__ → DatasetFactory → import pandas).
#     War im Isaac-Sim-5.1-Bundle enthalten, im 6.0-Bundle NICHT mehr → explizit pinnen
#     (Beweis: Build-Abbruch "No module named 'pandas'" beim ersten 6.0-Build, 2026-08-07).
# scipy (1.18.0), termcolor (3.3.0), wandb (0.28.0) sind im 6.0-Bundle bereits enthalten
# (pip-list-Inventar 2026-08-07) — NICHT pinnen: die uv.lock-Versionen wären Downgrades, und
# scipy==1.15.3 verlangt numpy<2.5 → pip würde das Bundle-numpy (2.5.1) mit-downgraden!
# torch/torchvision/numpy ebenso NICHT pinnen — liefert das Bundle (torch 2.10.0+cu128,
# torchvision 0.25.0+cu128, numpy 2.5.1); ein uv.lock-Pin (torch 2.7.1) würde sie ersetzen.
# ⚠️ numpy-Sprung: gr00t ist gegen numpy 1.26.4 (uv.lock) entwickelt, das Bundle hat 2.5.1 —
# Import-Brüche fängt der Smoke-Test unten, numerisches Verhalten prüft der erste echte Lauf.
# Übrige Pins = uv.lock. Geprüft: ziehen weder torch noch transformers/numpy um.
RUN unset VIRTUAL_ENV && \
    /workspace/isaaclab/_isaac_sim/python.sh -m pip install \
        transformers==4.51.3 tokenizers==0.21.4 accelerate==1.13.0 \
        huggingface_hub==0.36.2 einops==0.8.1 safetensors==0.7.0 && \
    /workspace/isaaclab/_isaac_sim/python.sh -m pip install \
        albumentations==1.4.18 dm-tree==0.1.8 diffusers==0.35.1 peft==0.17.1 \
        lmdb==1.7.5 av==16.1.0 tyro==0.9.17 \
        pandas==2.2.3 && \
    /workspace/isaaclab/_isaac_sim/python.sh -m pip install \
        "https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.1/flash_attn-2.8.1+cu12torch2.10cxx11abiTRUE-cp312-cp312-linux_x86_64.whl" && \
    /workspace/isaaclab/_isaac_sim/python.sh -m pip install -e /app/Groot-1.6 --no-deps && \
    /workspace/isaaclab/_isaac_sim/python.sh -c \
        "from gr00t.policy.gr00t_policy import Gr00tPolicy; \
         import gr00t.model.gr00t_n1d6.gr00t_n1d6, gr00t.model.modules.dit; \
         import flash_attn, diffusers, peft, tree, albumentations, lmdb, av, tyro; \
         print('OK: gr00t-Modell-Impl + flash_attn vollstaendig im Isaac-Sim-Python')"

# Eigener Sim-Code (identisch mit KISSKI-Container)
COPY g1_dex3_sim/ /workspace/g1_dex3_sim/

# Baseline-Pfad: stock G1 + Dex1-Greifer (UNITREE_G1), un-finetuntes Modell.
# Aktiv via SIM_MODE=baseline; lässt den DEX3-Default-Pfad unverändert.
COPY g1_gripper_sim/ /workspace/g1_gripper_sim/

# USD-Assets-Verzeichnis (g1_dex3.usd per Volume-Mount oder manuell rein)
RUN mkdir -p /workspace/assets

# Entrypoint-Skript
COPY scripts/ /scripts/
RUN chmod +x /scripts/*.sh

# Datenverzeichnisse (vast.ai: Disk-Volume nach /data mounten empfohlen)
RUN mkdir -p /data/models /data/checkpoints /data/sim_videos /data/sim_results /data/logs

# Isaac Sim Cache auf persistenten Pfad (innerhalb /data, überlebt Container-Stop auf vast.ai)
ENV OMNI_CACHE=/data/.omni_cache \
    NVCACHE_PATH=/data/.nvcache

ENV PATH="/app/Groot-1.6/.venv/bin:${PATH}" \
    VIRTUAL_ENV="/app/Groot-1.6/.venv" \
    GROOT_ROOT="/app/Groot-1.6" \
    UV_PREVIEW=1 \
    # Sim-Konfiguration (via -e beim docker run überschreiben)
    DATA_DIR="/data" \
    ZMQ_PORT="5555" \
    NUM_EPISODES="20" \
    EXECUTION_HORIZON="8" \
    TASK_DESCRIPTION="stack the blocks" \
    ASSET_PATH="/workspace/assets/g1_dex3_blackhands.usd" \
    # Checkpoint: entweder CHECKPOINT_PATH (Volume) oder HF_CHECKPOINT_REPO (Download)
    CHECKPOINT_PATH="/data/checkpoints" \
    HF_CHECKPOINT_REPO="" \
    # flash-attn: 0=aktiviert (RTX 3090+), 1=deaktiviert (sicherer Fallback)
    NO_FLASH_ATTN="0" \
    GROOT_INFERENCE_BACKEND="eager" \
    GROOT_TRT_ENGINE_PATH="" \
    CAMERA_RENDER_EVERY_N="1" \
    SKIP_DOWNLOAD="0" \
    SHELL_ON_ERROR="0" \
    # Sim-Modus: leer/dex3 = DEX3-Closed-Loop (Default), baseline = stock G1 + Dex1-Greifer
    # (UNITREE_G1, un-finetuntes GR00T-N1.6-3B). Bei baseline ASSET_PATH auf g1_gripper.usd setzen.
    SIM_MODE="dex3" \
    # LIVE-Variante "Spur A": WebRTC-Viewport statt MP4-Aufzeichnung. 0=aus,
    # 1=öffentlich, 2=privat/lokal. Geöffnet wird er vom nativen "Isaac Sim WebRTC
    # Streaming Client" auf dem Arbeitsrechner — docs/simulation/live-ansicht.md.
    # LIVESTREAM_PORT auf vast.ai auf den EXTERN gemappten Port setzen (intern==extern).
    LIVESTREAM="0" \
    LIVESTREAM_PORT="49100" \
    LIVESTREAM_MEDIA_PORT="47998" \
    # 1 = trotz Live-Variante zusätzlich MP4s schreiben (Default: live STATT Video).
    LIVE_KEEP_VIDEO="0" \
    # Live-Ansicht "Spur B" (MJPEG im Browser, live_view.py) — braucht weder NVENC
    # noch UDP und überlebt Netzabbrüche; empfohlen für den langen RL-Lauf.
    LIVE_VIEW="0" \
    LIVE_VIEW_PORT="8900" \
    LIVE_VIEW_EVERY_N="1" \
    # Default = die per Overlay kalibrierten POLICY-Kameras (= Modell-Eingabe).
    # cam_scene ist eine unvalidierte Übersichtskamera; Diagnose: dump_camera_poses.py.
    LIVE_VIEW_CAMS="cam_left_high,cam_left_wrist"

# Livestream-Ports (nur Doku/Default; beim docker run separat mappen —
# server_rl_run.sh tut das beim Anlegen des Containers selbst).
# Spur A — WebRTC-Viewport (nativer "Isaac Sim WebRTC Streaming Client"):
#   NVENC ist in NVIDIA_DRIVER_CAPABILITIES=all enthalten.
#   49100/tcp = Signaling/Steuerung   — beide Ports intern==extern mappen, weil WebRTC
#   47998/udp = Medien-Stream (Video)   sie in die SDP-Aushandlung einbettet.
#   8211/tcp war der Browser-Client aus Isaac Sim <=5.x — in 6.0 ENTFALLEN, deshalb hier
#   nicht mehr exponiert (er lieferte nur eine URL, die garantiert ins Leere lief).
# Spur B — MJPEG-Frame-Stream (-p 8900:8900), reines HTTP, tunnelbar per ssh -L.
EXPOSE 49100 8900
EXPOSE 47998/udp

WORKDIR /workspace

# Das isaac-lab-3.0-Basis-Image erbt einen HEALTHCHECK, der Isaac-Sim-Kit-Logs auf "AppReady"
# greppt. Unsere Entrypoints (Sim-Eval, RL, Workbench-`sleep infinity`) schreiben diese Logs
# nicht → der Container stünde dauerhaft auf "unhealthy". Health-Check daher deaktivieren.
HEALTHCHECK NONE

ENTRYPOINT ["/scripts/entrypoint_sim.sh"]
