# syntax=docker/dockerfile:1
# Sim + GR00T-Policy-Server — kombinierter Container für vast.ai
#
# Im Gegensatz zum KISSKI-Sim-Container (Dockerfile) enthält dieses Image BEIDE Prozesse:
#   * Isaac Lab / Isaac Sim  — Sim-Client (headless EGL, 4 RGB-Kameras)
#   * GR00T N1.6 Policy      — ZMQ-Server (isolierte venv, kein Dependency-Konflikt)
# Beide starten autonom via /scripts/entrypoint_sim.sh und kommunizieren
# über ZMQ auf localhost:${ZMQ_PORT} (default 5555).
#
# GPU-Anforderung:
#   ≥24 GB VRAM, Ampere+ (RT-Cores für Kamera-Rendering), z. B.:
#   RTX 3090 (24 GB), RTX 4090 (24 GB), A6000 (48 GB), A100 (80 GB, kein RT-Rendering!)
#   ACHTUNG: A100/H100 fehlen RT-Cores → Kamera-Rendering scheitert → nicht geeignet.
#   Auf vast.ai: Filter nach "RTX 3090", "RTX 4090" oder "A6000".
#
# Build (vom Repo-Root aus, Kontext = Simulation/):
#   docker build --platform linux/amd64 \
#     -f Simulation/Dockerfile.vastai \
#     -t lucam03/projekt-humanoider-roboter-sim-vastai:latest \
#     Simulation/
#
# Run (lokal zum Testen):
#   docker run -it --rm --gpus all --ipc=host --shm-size=16g \
#     -e HF_TOKEN=hf_... \
#     -e CHECKPOINT_PATH=/data/checkpoints/checkpoint-3000 \
#     -v /pfad/zum/checkpoint:/data/checkpoints \
#     lucam03/projekt-humanoider-roboter-sim-vastai:latest
#
# Interaktive Shell (Entrypoint überspringen):
#   docker run -it --rm --gpus all --ipc=host --shm-size=16g \
#     lucam03/projekt-humanoider-roboter-sim-vastai:latest bash

FROM nvcr.io/nvidia/isaac-lab:2.3.2

SHELL ["/bin/bash", "-c"]

# Isaac Sim EULA/Privacy (non-interaktiv)
ENV ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y \
    NVIDIA_DRIVER_CAPABILITIES=all \
    OMNI_KIT_ACCEPT_EULA=yes

# System-Pakete (zusätzlich zum Isaac-Lab-Basis-Image)
# Isaac Lab 2.3.2 basiert auf Ubuntu 24.04 (Noble) — python3.10-* nicht im Haupt-Repo.
# Deadsnakes-PPA liefert Python 3.10, das mit dem uv.lock des Training-Containers kompatibel ist.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-venv \
        python3.10-dev \
        python3-pip \
        git \
        git-lfs \
        curl \
        wget \
        openssh-server \
    && git lfs install \
    && mkdir -p /var/run/sshd /root/.ssh \
    && chmod 700 /root/.ssh \
    && ssh-keygen -A

# uv Paketmanager (exakte Version wie Training-Container)
RUN curl -LsSf https://astral.sh/uv/0.8.14/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# GR00T klonen — gepinnter Commit, identisch mit Training-Container
RUN git clone --branch luca/g1-dex3 https://github.com/lucam06/Isaac-GR00T.git /app/Groot-1.6 \
    && git -C /app/Groot-1.6 checkout 9508b498cb60c0048a8a3ce562b518b53f3d0bcf \
    && git -C /app/Groot-1.6 lfs pull

# GR00T Python-Abhängigkeiten in ISOLIERTER venv installieren.
# Isaac Lab nutzt ${ISAACLAB_PATH}/isaaclab.sh -p (eigenes Python-Bundle).
# GR00T nutzt /app/Groot-1.6/.venv/bin/python — keine gemeinsamen Packages, kein Konflikt.
#
# WICHTIG: venv explizit mit Python 3.10 anlegen. Das isaac-lab-Basisimage (Ubuntu 24.04)
# liefert als system-python3 die Version 3.12. Ohne --python würde uv eine 3.12-venv bauen,
# für die keine Header installiert sind (nur python3.10-dev) → Triton/transformers ruft
# `gcc -I/usr/include/python3.12` auf und scheitert mit "Python.h not found".
# Mit 3.10 entspricht die venv exakt dem funktionierenden Training-Container.
WORKDIR /app/Groot-1.6
RUN uv venv --python /usr/bin/python3.10 /app/Groot-1.6/.venv
RUN UV_PREVIEW=1 UV_HTTP_TIMEOUT=300 UV_CONCURRENT_DOWNLOADS=4 \
    uv sync --frozen --no-install-project --extra dev --no-cache
RUN uv pip install --python /app/Groot-1.6/.venv/bin/python -e . --no-deps
RUN uv pip install --python /app/Groot-1.6/.venv/bin/python jsonlines pyzmq msgpack

# Build-Time-Smoke-Test: venv-Python-Version prüfen und sicherstellen, dass die passenden
# Python-Header vorhanden sind (sonst scheitert Triton zur Laufzeit). Bricht den Build
# lokal/kostenlos ab, statt erst auf einer bezahlten vast.ai-Instanz aufzufallen.
RUN PYVER=$(/app/Groot-1.6/.venv/bin/python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")') \
    && echo "venv-Python: $PYVER" \
    && test -f "/usr/include/python${PYVER}/Python.h" \
        && echo "OK: Python-Header /usr/include/python${PYVER}/Python.h vorhanden" \
        || (echo "FEHLER: /usr/include/python${PYVER}/Python.h fehlt — Triton-Kompilierung würde fehlschlagen"; exit 1)

# Eigener Sim-Code (identisch mit KISSKI-Container)
COPY g1_dex3_sim/ /workspace/g1_dex3_sim/

# USD-Assets-Verzeichnis (g1_dex3.usd per Volume-Mount oder manuell rein)
RUN mkdir -p /workspace/assets

# Entrypoint-Skript
COPY scripts/ /scripts/
RUN chmod +x /scripts/*.sh

# Datenverzeichnisse (vast.ai: Disk-Volume nach /data mounten empfohlen)
RUN mkdir -p /data/models /data/checkpoints /data/sim_videos /data/sim_results /data/logs

# Isaac Sim Cache auf persistenten Pfad (innerhalb /data, überlebt Container-Stop auf vast.ai)
ENV OMNI_CACHE=/data/.omni_cache \
    NVCACHE_PATH=/data/.nvcache

ENV PATH="/app/Groot-1.6/.venv/bin:${PATH}" \
    VIRTUAL_ENV="/app/Groot-1.6/.venv" \
    GROOT_ROOT="/app/Groot-1.6" \
    UV_PREVIEW=1 \
    # Sim-Konfiguration (via -e beim docker run überschreiben)
    DATA_DIR="/data" \
    ZMQ_PORT="5555" \
    NUM_EPISODES="20" \
    EXECUTION_HORIZON="8" \
    TASK_DESCRIPTION="stack the blocks" \
    ASSET_PATH="/workspace/assets/g1_dex3.usd" \
    # Checkpoint: entweder CHECKPOINT_PATH (Volume) oder HF_CHECKPOINT_REPO (Download)
    CHECKPOINT_PATH="/data/checkpoints" \
    HF_CHECKPOINT_REPO="" \
    # flash-attn: 0=aktiviert (RTX 3090+), 1=deaktiviert (sicherer Fallback)
    NO_FLASH_ATTN="0" \
    SKIP_DOWNLOAD="0" \
    SHELL_ON_ERROR="0"

WORKDIR /workspace

ENTRYPOINT ["/scripts/entrypoint_sim.sh"]
