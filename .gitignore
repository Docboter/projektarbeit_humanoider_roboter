# ============================================================
# Projektarbeit Humanoider Roboter – .gitignore
# ============================================================

# --- Große Modell-Gewichte (>100 MB, GitHub-Limit) ---
/data/models/
*.safetensors
*.pt
*.pth
*.ckpt
*.bin

# --- Rohdatensätze (Videos & große Binärdaten) ---
/data/unitreerobotics/
# Fremder Sim-Datensatz + harmonisierte Fassung (docs/training/synth-datensatz.md)
/data/cotrain_synth/
/data/cube_stacking_synth_v21/
/data/cube_stacking_synth_v22/
/data/cotrain_synth_jointspace/
/data/cube_stacking_synth_jointspace_v21/
*.mp4
*.avi
*.mov

# --- Training-Logs ---
/data/logs/

# --- SLURM-Logs ---
/logs/

# --- HuggingFace Download-Cache ---
**/.cache/huggingface/
**/.cache/

# --- Python Build-Artefakte ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/dist/
**/build/
**/.eggs/

# --- Tool-Caches ---
**/.pytest_cache/
**/wandb/
**/.ipynb_checkpoints/
**/.triton/
**/.ruff_cache/

# --- Build-Logs (mit Timestamp im Dateinamen) ---
Simulation/build_sim_*.log

# --- Sim-Eval-Ausgaben (Trajektorien-Bilder, Videos, JSON-Results) ---
Simulation/runs/
Simulation/robocasa_reference/runs/
/last_log.md

# --- Menue-Profile (zuletzt benutzte Parameter je Aktion, maschinenlokal) ---
# Geschrieben von tools/lib_menu.sh. Enthaelt Pfade und Ports der jeweiligen Maschine,
# keine Geheimnisse — gehoert trotzdem nicht ins Repo, weil es pro Rechner abweicht.
.menu/

# --- Graphify-Ausgaben (vollständig generiert, nicht tracken) ---
# Ohne fuehrenden Slash: trifft graphify-out/ im Repo-Root UND unter latex/.
graphify-out/

# --- Sensible Dateien (API-Keys) ---
.env
.env.local
.env.*.local

# --- Python venv ---
.venv/
venv/

# --- OS-Artefakte ---
Thumbs.db
.DS_Store
