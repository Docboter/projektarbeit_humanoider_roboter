# ============================================================
# Projektarbeit Humanoider Roboter – Container .gitignore
# ============================================================

# --- System-Verzeichnisse ---
/proc/
/sys/
/dev/
/run/
/srv/
/boot/
/media/
/mnt/
/usr/
/lib
/lib32
/lib64
/libx32
/sbin
/bin
/etc/
/opt/
/tmp/
/var/

# --- Container-spezifisches ---
/.dockerenv
/NGC-DL-CONTAINER-LICENSE
/cuda-keyring_1.0-1_all.deb

# --- /root: enthält nur Tool-Configs & sensible Daten ---
/root/

# --- Groot-1.6: NVIDIA-Basis ignorieren, eigene Änderungen tracken ---
/app/Groot-1.6/*
!/app/Groot-1.6/examples/
/app/Groot-1.6/examples/*
!/app/Groot-1.6/examples/G1_DEX3/
!/app/Groot-1.6/scripts/
/app/Groot-1.6/scripts/*
!/app/Groot-1.6/scripts/lerobot_conversion/
/app/Groot-1.6/scripts/lerobot_conversion/*
!/app/Groot-1.6/scripts/lerobot_conversion/convert_v3_to_v2_standalone.py
!/app/Groot-1.6/uv.lock

# --- Große Modell-Gewichte (>100 MB, GitHub-Limit) ---
/data/models/
*.safetensors
*.pt
*.pth
*.ckpt
*.bin

# --- Rohdatensätze (Videos & große Binärdaten) ---
/data/unitreerobotics/
*.mp4
*.avi
*.mov



# --- Training-Logs ---
/data/logs/

# --- SLURM-Logs ---
/logs/

# --- HuggingFace Download-Cache ---
**/.cache/huggingface/
**/.cache/

# --- Python Build-Artefakte ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/dist/
**/build/
**/.eggs/

# --- Tool-Caches ---
**/.pytest_cache/
**/wandb/
**/.ipynb_checkpoints/
**/.triton/

# --- Build-Logs (mit Timestamp im Dateinamen) ---
Simulation/build_sim_*.log

# --- Sim-Eval-Ausgaben (Trajektorien-Bilder, Videos, JSON-Results) ---
Simulation/runs/
Simulation/robocasa_reference/runs/
/last_log.md

# --- Graphify-Ausgaben (vollständig generiert, nicht tracken) ---
graphify-out/

# --- Sensible Dateien (API-Keys) ---
.env
.env.local
.env.*.local

# --- Python venv ---
.venv/
venv/

# --- OS-Artefakte ---
Thumbs.db
.DS_Store
