# Copy to .env.groot-unitree on the workstation and adjust.

# Directory that contains this repo and its repos/ submodules.
PROJECTS_DIR=.

# Best case: run GR00T and Isaac on separate GPUs.
# Inside each container the selected GPU appears as cuda:0.
GROOT_GPU=0
SIM_GPU=1

GROOT_PORT=5555
GROOT_HOST=127.0.0.1
GROOT_MODEL_PATH=checkpoints/GR00T-N1.6-G1-PnPAppleToPlate
GROOT_EMBODIMENT_TAG=UNITREE_G1

UNITREE_TASK=Isaac-Move-Cylinder-G129-Dex3-Wholebody
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
GROOT_TIMEOUT_MS=120000
GROOT_ACTION_STEP=0

# Examples:
# UNITREE_EXTRA_ARGS=--groot_debug --groot_dry_run
# UNITREE_EXTRA_ARGS=--groot_debug
UNITREE_EXTRA_ARGS=--groot_debug --groot_dry_run
