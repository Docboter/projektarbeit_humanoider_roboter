# Copy to docker/.env.simulation and set the address reachable from your laptop.
PUBLIC_IP=192.168.1.50

# 2 = private/institute network; 1 = publicly routed host.
LIVESTREAM_TYPE=2
SIM_GPU=all

UNITREE_TASK=Isaac-Stack-RgyBlock-G129-Dex3-Joint
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
EPISODE_LENGTH_S=3600

# Relative paths are resolved from the docker/ directory.
UNITREE_ASSETS_DIR=../repos/unitree_sim_isaaclab/assets

# Optional extra sim_main.py arguments.
UNITREE_SIM_EXTRA_ARGS=
