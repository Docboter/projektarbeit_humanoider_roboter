# Example environment for the single-container Vast.AI setup.
# Use it as a reference for docker run -e values or Vast template env vars.

# GR00T PolicyServer
GROOT_MODEL_PATH=checkpoints/GR00T-N1.6-G1-PnPAppleToPlate
GROOT_EMBODIMENT_TAG=UNITREE_G1
GROOT_HOST_BIND=0.0.0.0
GROOT_HOST=127.0.0.1
GROOT_PORT=5555
GROOT_CUDA_DEVICE=0

# Isaac/Unitree simulation
UNITREE_TASK=Isaac-Move-Cylinder-G129-Dex3-Wholebody
ROBOT_TYPE=g129
DEX_HAND_ARG=--enable_dex3_dds
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
GROOT_TIMEOUT_MS=120000
GROOT_ACTION_STEP=0
UNITREE_EXTRA_ARGS=--groot_debug --groot_dry_run

# Isaac livestream
# For Vast.AI set this to the instance public IP/hostname.
PUBLIC_IP=127.0.0.1
LIVESTREAM_TYPE=1
